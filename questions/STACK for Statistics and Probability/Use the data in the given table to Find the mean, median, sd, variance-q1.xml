    <td style="text-align:center"></td>
    <td style="text-align:center">\(\sum fX_i={@sum_fxi@}\)</td>
    <td style="text-align:center">\(\sum{f(X_i-\mu)^2}={@mean_squared_diffs@}\)</td>
