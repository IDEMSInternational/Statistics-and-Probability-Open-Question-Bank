    <questionvariables>
      <text><![CDATA[class_widths:rand(15)+5;
/*randomly generating class intervals*/
aa:rand(200)+10;
lower_range1: aa+ class_widths;  /*Adding 5 on each variable to ensure the subsequent class width is the same*/
upper_range1: lower_range1 + class_widths;

lower_range2: upper_range1 + 1;
upper_range2: lower_range2 + class_widths;

lower_range3: upper_range2 + 1;
upper_range3: lower_range3 + class_widths;

lower_range4: upper_range3 + 1;
upper_range4: lower_range4 + class_widths;

lower_range5: upper_range4 + 1;
upper_range5: lower_range5 + class_widths;

error_bound:((lower_range2-upper_range1)/2);

lower_bound1: lower_range1-error_bound;  /*Adding 0.5 and subtracting 0.5 as the correcting factor for class boundaries*/
upper_bound1: upper_range1+error_bound;

lower_bound2:  lower_range2-error_bound;
upper_bound2: upper_range2+error_bound;

lower_bound3:  lower_range3-error_bound;
upper_bound3: upper_range3+error_bound;

lower_bound4:  lower_range4-error_bound;
upper_bound4: upper_range4+error_bound;

lower_bound5:  lower_range5-error_bound;
upper_bound5: upper_range5+error_bound;

lower_boundaries: [lower_bound1, lower_bound2, lower_bound3, lower_bound4, lower_bound5];
upper_boundaries: [upper_bound1, upper_bound2, upper_bound3,upper_bound4, upper_bound5];
class_widths: upper_boundaries - lower_boundaries;

midpoints: (float(lower_boundaries + class_widths / 2));

frequencies:makelist(rand_with_step(2,20,2),5);/*create a list with 5 elements randomly picked between 2-20 for even N*/
f1:frequencies[1];         
f2:frequencies[2]+6;
f3:frequencies[3]+2; 
f4:frequencies[4]+4;
f5:frequencies[5];    
frequencies:[f1,f2,f3,f4,f5]; 

/*cumulative frequencies*/
cf: makelist(sum(frequencies[i], i, 1, j), j, 1, length(frequencies));
/*sum(frequencies);*/
n:sum(frequencies[i],i,1,5); 
total_f:n;

midpointss: lower_boundaries + class_widths / 2;
midpoints1:decimalplaces(midpointss,2);
mptd1:round(midpoints1);
mptd_1:is(abs((midpoints1-mptd1)[1])=0.0);
midpoints: if mptd_1=true then mptd1 else midpoints1;

fxis:(midpoints * frequencies);
fxis1:decimalplaces(fxis,2);
fxis11:round(fxis);
fxis_1:is(abs((fxis1-fxis11)[1])=0.0);
fxi: if fxis_1=true then fxis11 else fxis1;
sum_fxi:sum(fxi[i],i,1,5);

/* Mean */
sum_fx:sum((midpoints * frequencies)[i], i, 1, 5);
means: sum_fx / n;
meanss:decimalplaces(means,2);
mean1:round(mean);
mean_1:is(abs((meanss-mean1))=0.0);
mean: if mean_1=true then mean1 else meanss;

/*median*/
median_cf: n / 2;

i: 1;
while cf[i] < median_cf do i: i + 1;

median_cf;
lower_bound:lower_boundaries[i];/*L is the lower limit of the median class.*/
upper_bound: upper_boundaries[i];
cf_lower: cf[i-1]; /*cf is the cumulative frequency of the class before the median class.*/
f_median: frequencies[i]; /*f is the frequency of the median class.*/
width: upper_range2 - upper_range1; /*w is the interval width (the difference between the upper and lower limits of each class).*/

median_height: lower_boundaries[i] + (median_cf - cf[i-1]) * class_widths[i] / frequencies[i];
md1: float( (median_cf - cf[i-1]) * class_widths[i] / frequencies[i]);

/*closest median height integer*/
median_height1:decimalplaces(median_height,2);
ta1:round(median_height1);
ta_1:is(abs(round(median_height1)-median_height1)=0.0);
ta: if ta_1=true then ta1 else median_height1;

/*mode*/
max_freq: apply('max, frequencies);
modal_class_index: 1;
max_value: frequencies[1];

for i: 2 thru length(frequencies) do (
    if frequencies[i] > max_value then (
        max_value: frequencies[i],
        modal_class_index: i
    )
);

Lm: lower_boundaries[modal_class_index];
f1m: frequencies[modal_class_index];
f0m: frequencies[modal_class_index-1];
f2m: frequencies[modal_class_index+1];
hm: upper_boundaries[modal_class_index] - lower_boundaries[modal_class_index];

Mode: Lm + ((f1m - f0m) / ((f1m - f0m) + (f1m - f2m))) * hm;

Modes: Mode;
Modess:decimalplaces(Modes,2);
Modes1:round(Modes);
Modes_1:is(abs((Modess-Modes1))=0.0);
Mode: if Modes_1=true then Modes1 else Modess;

mean_fdiffss:(midpoints - mean)^2 * frequencies;
mean_fdiffs1:decimalplaces(mean_fdiffss,2);
mean_fdiffs11:round(mean_fdiffss);
mean_fdiffs_1:is(abs((mean_fdiffs1-mean_fdiffs11)[1])=0.0);
mean_fdiffs: if mean_fdiffs_1=true then mean_fdiffs11 else mean_fdiffs1;

/* Variance */
mean_squared_diffs: sum((mean_fdiffs)[i],i,1,5);
variances: mean_squared_diffs / n;
variancess:decimalplaces(variances,2);
variance1:round(variances);
variance_1:is(abs((variancess-variance1))=0.0);
variance: if variance_1=true then variance1 else variancess;

/* Standard Deviation */
standard_deviations: sqrt(variance);
standard_deviationss:decimalplaces(standard_deviations,2);
standard_deviation1:round(standard_deviations);
standard_deviation_1:is(abs((standard_deviationss-standard_deviation1))=0.0);
standard_deviation: if standard_deviation_1=true then standard_deviation1 else standard_deviationss;]]></text>
