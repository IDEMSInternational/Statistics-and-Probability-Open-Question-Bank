lights_heatn: float(lightn_heatn + rand(10)/10 + 1 + rand(2));
lightn_heats: float(lights_heatn + rand(10)/10 + 2 + rand(3));
heat_diff: float(round((lightn_heats - lightn_heatn)*10)/10);
ta1: lights_heatn + lightn_heats - lightn_heatn;
ta1: float(round(ta1*10)/10);
ta2: lightn_heats;
ta3: ta1+ 5;</text>
