    <questionvariables>
      <text>C:rand_with_step(10,30,5);/*poor products receiving good news */
prob_C:decimalplaces((C/100),2);
B:rand_with_step(10,30,5)+C;/*moderately successful products receiving good news*/
prob_B:decimalplaces((B/100),2);
A:rand_with_step(10,30,5)+B;/*Highly succesful products receiving good news*/
prob_A:decimalplaces((A/100),2);
product_A:rand(30)+10;/*products that have been highly succesful*/
product_B:rand(30)+10;/*products that have been moderately succesful*/
product_C:100-(product_A+product_B);/*products that have been poor*/


product_A_1:decimalplaces((product_A/100),2);
product_B_1:decimalplaces((product_B/100),2);
product_C_1:decimalplaces((product_C/100),2);
prob_good_review:(prob_A*product_A_1)+(prob_B*product_B_1)+(prob_C*product_C_1);
prob_good_success:(prob_A*product_A_1)/prob_good_review;
prob_poor_success:((1-prob_A)*product_A_1)/(1-prob_good_review);
ta_1:decimalplaces(prob_good_review,3);
ta_2:decimalplaces(prob_good_success,3);

ta_3:decimalplaces(prob_poor_success,3);
/*mistakes*/
ta_11:round(ta_1);
ta_21:round(decimalplaces(prob_good_success,3));

ta_31:round(decimalplaces(prob_poor_success,3));</text>
    </questionvariables>
