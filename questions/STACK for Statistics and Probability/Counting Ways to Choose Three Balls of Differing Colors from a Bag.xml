first:(binomial(red_balls, 1)*binomial(green_balls, 2));second:(binomial(red_balls, 1)*binomial(blue_balls, 2));third:(binomial(blue_balls, 2)*binomial(green_balls, 1));fourth:(binomial(red_balls, 2)*binomial(green_balls, 1));fifth:(binomial(red_balls, 2)*binomial(blue_balls, 1));sixth:(binomial(blue_balls, 1)*binomial(green_balls, 2));ta:first+second+third+fourth+fifth+sixth;
</text>
