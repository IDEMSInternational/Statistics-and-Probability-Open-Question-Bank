    <questionvariables>
      <text>/*probability of events*/
p_a_b_prime:float((rand(7)+1)/10)+0.1;
p_a:float((rand(5)+1)/10);
p_b_prime:float((rand(3)+1)/10);


/*worked solution variables*/
p_b:1-p_b_prime;
p_a_b:1-p_a_b_prime;
sol1:(p_a_b_prime*p_b_prime)/((p_b_prime*p_a_b_prime)+(p_b*p_a_b));

/*correcting to 1dp*/
ta: sol1;
modess:decimalplaces(ta,1);
modes1:round(ta);
modes_1:is(abs((modess-modes1))=0.0);
ta1: if modes_1=true then modes1 else modess;

/*prt test*/
s1:rat(sol1);</text>
