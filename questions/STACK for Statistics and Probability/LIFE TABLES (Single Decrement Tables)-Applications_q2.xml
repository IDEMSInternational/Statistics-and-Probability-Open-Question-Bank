	val_lx: [100000, 97761, 97584, 97467, 97379, 97315, 97259, 97206, 97154, 97105, 97082, 97022, 96981, 96936, 96885, 96825, 96752, 96660, 96541, 96384, 96215, 96049, 95886, 95728, 95577, 95432, 95292, 95154, 95014, 94871, 94726, 94577, 94425, 94267, 94123, 93931, 93749, 93554, 93349, 93112, 92859, 92580, 92374, 91938, 91569, 91165, 90723, 90238, 89705, 89118, 88473, 87762, 86879, 86119, 85175, 84142]; 


 val_ly: [100000, 98243, 98074, 97974, 97911, 97854, 97805, 97762, 97725, 97693, 97664, 97637, 97611, 97584, 97556, 97525, 97488, 97443, 97391, 97335, 97278, 97220, 97161, 97101, 97042, 96984, 96924, 96861, 96794, 96723, 96649, 96570, 96485, 96392, 96292, 96183, 96065, 95936, 95797, 95646, 95481, 95302, 95107, 94893, 94658, 94400, 94117, 93809, 93474,93109,92713, 92283, 91817, 91314, 90773, 90191]; 
	
/* Given data */
index_num:rand(40)+3;
age_index30:age[index_num];
age_female:age_index30+1;/*age of a female*/
age_male:age_index30+3;/*age of a male*/

age:rand(15)+5;/*age both male and female die*/
female_die:age_female+age;
male_die:age_male+age;
num_male_dying:val_lx[age_male+1];   /* Number of males dying at their age */ 
num_female_dying:val_ly[age_female+1];   /* Number of females dying at their age */

num_male_dying_age:val_lx[male_die+1];   /* Number of males dying at age  */ 
num_female_dying_age:val_ly[female_die+1];   /* Number of females dying at age */ 
 

chance_male_die:(num_male_dying-num_male_dying_age)/num_male_dying;
chance_female_die:(num_female_dying-num_female_dying_age)/num_female_dying;
ta:decimalplaces((chance_male_die*chance_female_die),4);





</text>
