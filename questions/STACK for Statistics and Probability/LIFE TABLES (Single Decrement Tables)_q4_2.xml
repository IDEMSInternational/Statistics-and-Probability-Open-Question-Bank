/* Given data */
index_num:rand(40)+1;
age_index1:age[index_num];
age_index2:age_index1+20;
age_index3:age_index2+20;

T_num_1:val_Tx[age_index1+1]; /*T value at the first given age*/
T_num_2:val_Tx[age_index2+1]; /*T value at the second given age*/
T_num_3:val_Tx[age_index3+1]; /*T value at the third given age*/

l_num_1:val_lx[age_index1+1]; /*l value at the first given age*/
l_num_2:val_lx[age_index2+1]; /*l value at the second given age*/
l_num_3:val_lx[age_index3+1]; /*l value at the third given age*/
/*Model answers*/
ta1:decimalplaces((age_index1+(T_num_1/l_num_1)),2);
ta2:decimalplaces((age_index2+(T_num_2/l_num_2)),2);
ta3:decimalplaces((age_index3+(T_num_3/l_num_3)),2);</text>
