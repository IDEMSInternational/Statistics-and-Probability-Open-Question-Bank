m: rand(31) + 30;

/* Standard deviation of the recorded weights, in grams */
s: rand(4) + 2;

/* Amount by which the scale under-reports each weight, in grams */
e: rand(4) + 1;

/* Example actual weight used to illustrate the scale error */
x: rand(10) + 40;

/* Reported value for the illustrative fish */
x_reported: x - e;

/* Correct answers */
ta1: m + e;
ta2: s;</text>
