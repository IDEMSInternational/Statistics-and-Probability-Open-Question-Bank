    <questionvariables>
      <text>/* ABRIDGED LIFE TABLES_q4*/
x_1:rand_with_step(20,60,5);
x_2:x_1+1;
x_3:x_2+1;
x_4:x_3+1;
x_5:x_4+1;
x_6:x_5+1;
/*l_x*/
l_x1:rand_with_step(89600,90000,200);
l_x2:rand_with_prohib(88800,89000,[l_x1]);
l_x3:rand_with_prohib(87800,88000,[l_x1,l_x2]);
l_x4:rand_with_prohib(86800,87000,[l_x1,l_x2,l_x3]);
l_x5:rand_with_prohib(85800,86000,[l_x1,l_x2,l_x3,l_x4]);
l_x6:rand_with_prohib(84800,85000,[l_x1,l_x2,l_x3,l_x4,l_x5]);
lx:[l_x1,l_x2,l_x3,l_x4,l_x5,l_x6];
/*d_x*/
d_x1:l_x1-l_x2;
d_x2:l_x2-l_x3;
d_x3:l_x3-l_x4;
d_x4:l_x4-l_x5;
d_x5:l_x5-l_x6;
d_x6:rand_with_prohib(200,1000,[d_x1,d_x2,d_x3,d_x4,d_x5]);
dx:[d_x1,d_x2,d_x3,d_x4,d_x5,d_x6];
/*q_x*/ 
/*q_x1:decimalplaces(d_x1/l_x1,4); 
q_x2:decimalplaces(d_x2/l_x2,4); 
q_x3:decimalplaces(d_x3/l_x3,4); 
q_x4:decimalplaces(d_x4/l_x4,4); 
q_x5:decimalplaces(d_x5/l_x5,4); 
q_x6:decimalplaces(d_x6/l_x6,4);*/
q_x1:(d_x1/l_x1); 
q_x2:(d_x2/l_x2); 
q_x3:(d_x3/l_x3); 
q_x4:(d_x4/l_x4); 
q_x5:(d_x5/l_x5); 
q_x6:(d_x6/l_x6);
qx:[q_x1,q_x2,q_x3,q_x4,q_x5,q_x6];
/*p_x*/
p_x1:1-q_x1;
p_x2:1-q_x2;
p_x3:1-q_x3;
p_x4:1-q_x4;
p_x5:1-q_x5;
p_x6:1-q_x6;
px:[p_x1,p_x2,p_x3,p_x4,p_x5,p_x6];
dx_values: makelist(lx[i]*qx[i], i, 1, 6); 
check_point:is(dx=dx_values);</text>
