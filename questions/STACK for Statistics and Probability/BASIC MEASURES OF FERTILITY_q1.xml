    <questionvariables>
      <text>/*general and fertility rates*/
age:rand(3)+4;
age_group1:rand_with_step(13,17,1);
age_group2:age_group1+age;
age_group3:age_group2+age;
age_group4:age_group3+age;
age_group5:age_group4+age;
age_group6:age_group5+age;
age_group7:age_group6+age;
age_group8:age_group7+age;

/*Female population (‘000’)*/
fem_pop1:rand_with_step(10,100,5);
fem_pop2:rand_with_prohib(10,100,[fem_pop1]);
fem_pop3:rand_with_prohib(10,100,[fem_pop1,fem_pop2]);
fem_pop4:rand_with_prohib(10,100,[fem_pop1,fem_pop2,fem_pop3]);
fem_pop5:rand_with_prohib(10,100,[fem_pop1,fem_pop2,fem_pop3,fem_pop4]);
fem_pop6:rand_with_prohib(10,100,[fem_pop1,fem_pop2,fem_pop3,fem_pop4,fem_pop5]);
fem_pop7:rand_with_prohib(10,100,[fem_pop1,fem_pop2,fem_pop3,fem_pop4,fem_pop5,fem_pop6]);
total_fem_pop:fem_pop1+fem_pop2+fem_pop3+fem_pop4+fem_pop5+fem_pop6+fem_pop7;
 /*Total fem pop*/
fem_popt1:fem_pop1*1000;
fem_popt2:fem_pop2*1000;
fem_popt3:fem_pop3*1000;
fem_popt4:fem_pop4*1000;
fem_popt5:fem_pop5*1000;
fem_popt6:fem_pop6*1000;
fem_popt7:fem_pop7*1000;

/*Number of live births*/
fem_birth1:rand_with_step(100,7000,50);
fem_birth2:rand_with_prohib(100,7000,[fem_birth1]);
fem_birth3:rand_with_prohib(100,7000,[fem_birth1,fem_birth2]);
fem_birth4:rand_with_prohib(100,7000,[fem_birth1,fem_birth2,fem_birth3]);
fem_birth5:rand_with_prohib(100,7000,[fem_birth1,fem_birth2,fem_birth3,fem_birth4]);
fem_birth6:rand_with_prohib(100,7000,[fem_birth1,fem_birth2,fem_birth3,fem_birth4,fem_birth5]);
fem_birth7:rand_with_prohib(100,7000,[fem_birth1,fem_birth2,fem_birth3,fem_birth4,fem_birth5,fem_birth6]);
total_fem_birth: fem_birth1+fem_birth2+fem_birth3+fem_birth4+fem_birth5+fem_birth6+fem_birth7;



/*worked solution variables*/
ASFR_1:decimalplaces(((fem_birth1/fem_popt1)*1000),4);
ASFR_2:decimalplaces(((fem_birth2/fem_popt2)*1000),4);
ASFR_3:decimalplaces(((fem_birth3/fem_popt3)*1000),4);
ASFR_4:decimalplaces(((fem_birth4/fem_popt4)*1000),4);
ASFR_5:decimalplaces(((fem_birth5/fem_popt5)*1000),4);
ASFR_6:decimalplaces(((fem_birth6/fem_popt6)*1000),4);
ASFR_7:decimalplaces(((fem_birth7/fem_popt7)*1000),4);
sum_ASFR:decimalplaces((ASFR_1+ASFR_2+ASFR_3+ASFR_4+ASFR_5+ASFR_6+ASFR_7),2);

/*ASFR*Survival rate(S)*/
ASFR_s1:decimalplaces((ASFR_1*age),4);
ASFR_s2:decimalplaces((ASFR_2*age),4);
ASFR_s3:decimalplaces((ASFR_3*age),4);
ASFR_s4:decimalplaces((ASFR_4*age),4);
ASFR_s5:decimalplaces((ASFR_5*age),4);
ASFR_s6:decimalplaces((ASFR_6*age),4);
ASFR_s7:decimalplaces((ASFR_7*age),4);
aa:ASFR_s1;bb:ASFR_s1+ASFR_s3;cc:ASFR_s1+ASFR_s2+ASFR_s3;dd:ASFR_s1+ASFR_s2+ASFR_s3+ASFR_s4; ee:ASFR_s1+ASFR_s2+ASFR_s3+ASFR_s4+ASFR_s5;ff:ASFR_s1+ASFR_s2+ASFR_s3+ASFR_s4+ASFR_s5+ASFR_s6;gg:ASFR_s1+ASFR_s2+ASFR_s3+ASFR_s4+ASFR_s5+ASFR_s6+ASFR_s7;
sum_ASFR_s:aa+bb+cc+dd+ee+ff+gg;
num_female_birth:round(total_fem_birth*(0.4+rand(0.2)));
/*model answers*/

ta1:decimalplaces((total_fem_birth/(total_fem_pop*100))*1000,4);/*Gross Reproduction Rate (GRR)*/
ta2:decimalplaces((gg/1000),4);
ta3:decimalplaces(((num_female_birth/total_fem_birth)*ta2),4);</text>
