    <questionvariables>
      <text>car_and_stereo: rand_with_step(50,600,50);   /* Number of students who own both a car and a stereo */ 
car_only:(rand(10)+1)*10; 
stereo_only:(rand(5)+1)*10; 
students_neither_car_nor_stereo: rand_with_step(50,300,10);   
total_sudents: car_and_stereo+car_only+stereo_only+students_neither_car_nor_stereo; /* Total number of students */   
car: car_and_stereo+car_only; /* Number of students who own a car */
stereo: car_and_stereo+stereo_only; /* Number of students who own a stereo */    
students_either_car_or_stereo: total_sudents-students_neither_car_nor_stereo;      
probability_stereo_given_car: (car_and_stereo/total_sudents) / (car/total_sudents); 
ta:probability_stereo_given_car;
</text>
