read_english: read_both+read_english_only;
read_hindi: read_both+read_hindi_only;  
/* Calculate the number of persons who read either Hindi or English or both */ 
persons_either_hindi_or_english: total_persons-persons_neither_hindi_nor_english;    

ta:persons_neither_hindi_nor_english; 
</text>
