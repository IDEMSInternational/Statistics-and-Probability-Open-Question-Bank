      <text>/*Randomly generate and calculate the initial probabilities*/
/* p_anb:float((rand(5)+1)/10);  p(AnB) */
/*p_a:float((rand(2)+1)/10+p_anb); P(A) */
/*p_b:float((rand(2)+1)/10+p_anb);  P(B) */
/*p_aub:float(p_a+p_b-p_anb);  P(AuB)*/
/*p_neither:1-p_aub; P((AuB)^c)*/

p_anb:decimalplaces(float((rand(3)+1)/10),2);  /*P(AnB)*/
p_a:decimalplaces(float((rand(2)+2)/10),2)+p_anb; /*P(A)*/
p_b:decimalplaces(float((rand(2)+1)/10),2)+p_anb;  /*P(B)*/
p_aub:p_a+p_b-p_anb;  /*P(AUB)*/
p_neither:1-p_aub;  /*P((AuB)^c)*/
/*model answers*/
ta1:decimalplaces((p_aub),2);   /*p(AuB)*/
ta2:decimalplaces((p_anb/p_a),2);   /*p(B|A)*/
ta3:decimalplaces(1- (p_anb/p_b),2); /*p(A|B)^c*/ 
ta4:decimalplaces((p_a-p_anb)/(1-p_b),2); /*p(A|B^c)*/</text>
    </questionvariables>
