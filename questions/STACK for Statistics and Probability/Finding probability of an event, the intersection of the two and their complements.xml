    <questionvariables>
      <text>/*Randomly generate and calculate the initial probabilities*/
p_cnd:float((rand(10)+10)/100);   /*P(CnD)*/
p_d: float(p_cnd+ (rand(30)+10)/100);  /*P(D)*/
p_c:float(p_cnd+ (rand(30)+10)/100); /*P(C)*/  
p_complement:decimalplaces(1-(p_d + p_c  - p_cnd),2);  /*complement of C and D*/


/*model answers*/
ta1: decimalplaces(p_d-p_cnd,2);
ta2:decimalplaces(1-p_complement-p_d+p_cnd,2); 
ta3: decimalplaces(ta2 - p_cnd,2);</text>
    </questionvariables>
