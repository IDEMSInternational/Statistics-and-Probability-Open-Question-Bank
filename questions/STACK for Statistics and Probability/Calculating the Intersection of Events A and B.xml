    <questionvariables>
      <text>/*Defining question variables*/

prob_AB:(rand(2)+1)/10;/*P(AnB)*/
prob_AB_1:(rand(2)+1)/10;/*P(AnB')*/
prob_AB_2:(rand(2)+1)/10;/*P(A'nB)*/
prob_A:prob_AB_1+prob_AB;/*P(A)*/
prob_B:prob_AB_2+prob_AB;/*P(B)*/
prob_C:prob_AB/prob_A;/*P(A|B)*/
prob_D:prob_AB/prob_B;/*P(B|A)*/
prob_E:prob_C+prob_D;/*P(A|B)+P(B|A)*/
ta:prob_AB;</text>
    </questionvariables>
