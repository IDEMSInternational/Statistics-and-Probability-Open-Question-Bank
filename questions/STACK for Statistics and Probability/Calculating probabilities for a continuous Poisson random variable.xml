    </stackversion>
    <questionvariables>
      <text><![CDATA[num_elephants:rand(10)+10;
num_regions:num_elephants+2+rand(10);
num_close:rand(3)+2;

mean:num_elephants/num_regions;

ta_1:%e^(-mean)*mean^num_close/(num_close!);
ta_2:%e^(-mean)*mean*num_regions;
ta_3:%e^(-mean)*num_regions;

disp_a_1:if gcd(num_elephants,num_regions)=1 then "" else "=";
disp_a_2:if gcd(num_elephants,num_regions)=1 then "" else mean;]]></text>
