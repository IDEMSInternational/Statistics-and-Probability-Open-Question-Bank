    <questionvariables>
      <text>/* Generate six consecutive data values */
x1: rand(11)+10;
x2: x1+1;
x3: x1+2;
x4: x1+3;
x5: x1+4;
x6: x1+5;

xvals: [x1,x2,x3,x4,x5,x6];


/* Generate six distinct frequencies between 5 and 14 */
f1: rand(10)+5;
f2: rand_with_prohib(5,14,[f1]);
f3: rand_with_prohib(5,14,[f1,f2]);
f4: rand_with_prohib(5,14,[f1,f2,f3]);
f5: rand_with_prohib(5,14,[f1,f2,f3,f4]);
f6: rand_with_prohib(5,14,[f1,f2,f3,f4,f5]);

freqs: [f1,f2,f3,f4,f5,f6];


/* Calculate cumulative frequencies */
cf1: f1;
cf2: cf1+f2;
cf3: cf2+f3;
cf4: cf3+f4;
cf5: cf4+f5;
cf6: cf5+f6;

cumfreqs: [cf1,cf2,cf3,cf4,cf5,cf6];


/* Total number of observations */
N: cf6;


/*
   Select two target rows in ascending order.

   row1 can be 2, 3 or 4.
   row2 is guaranteed to be strictly greater than row1,
   with a maximum value of 5.
*/
row1: rand(3)+2;
row2: row1 + rand(5-row1) + 1;


/*
   Cumulative frequencies immediately before and
   at the end of each selected row.
*/
cf_before1: cumfreqs[row1-1];
cf_after1: cumfreqs[row1];

cf_before2: cumfreqs[row2-1];
cf_after2: cumfreqs[row2];


/*
   Generate an integer observation position strictly
   inside each selected cumulative-frequency block.
*/
pos1: cf_before1 + 1 + rand(cf_after1-cf_before1-1);
pos2: cf_before2 + 1 + rand(cf_after2-cf_before2-1);


/*
   Convert each selected position into an integer
   percentile rank to display in the question.
*/
p1: round(100*pos1/N);
p2: round(100*pos2/N);


/*
   Recalculate the percentile positions from the
   percentile ranks actually shown to the student.
*/
ppos1: p1*N/100;
ppos2: p2*N/100;


/*
   Record whether the displayed percentile produces
   an exact integer observation position.
*/
intpos1: integerp(ppos1);
intpos2: integerp(ppos2);


/*
   Positions immediately below and above each
   calculated percentile position.

   These are used when the position is not an integer.
*/
lowerpos1: floor(ppos1);
upperpos1: ceiling(ppos1);

lowerpos2: floor(ppos2);
upperpos2: ceiling(ppos2);


/*
   Teacher answers.

   ta1-ta5: missing cumulative frequencies.
   ta6-ta7: values of the two requested percentiles.
*/
ta1: cf2;
ta2: cf3;
ta3: cf4;
ta4: cf5;
ta5: cf6;

ta6: xvals[row1];
ta7: xvals[row2];</text>
