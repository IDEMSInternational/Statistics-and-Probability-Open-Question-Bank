      <text>/*randomised question variables */

prob_both:rand(4)+3;
prob_french:rand(13)+3 +prob_both;
prob_german:rand(15)+3 + prob_both;
prob_notgerfre:rand(4)+1;
prob_total:prob_both+prob_french-prob_both+prob_german-prob_both+prob_notgerfre;
card_onlygerman:prob_german-prob_both;

/*model answers*/
ta1:prob_french/prob_total;
ta2:prob_both/prob_total;
ta3:(prob_french-prob_both)/prob_total;
ta4:prob_notgerfre/prob_total;</text>
