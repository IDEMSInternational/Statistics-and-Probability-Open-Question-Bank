    <questionvariables>
      <text>sample_space:{1,2,3,4,5,6};
cardinality_sample_space:cardinality (sample_space);
sample_space_even:{2,4,6};
cardinality_even:cardinality (sample_space_even);
ta:cardinality_even/cardinality_sample_space;</text>
