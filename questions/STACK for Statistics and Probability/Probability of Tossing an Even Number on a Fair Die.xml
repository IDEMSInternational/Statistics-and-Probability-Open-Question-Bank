<quiz><question type="stack">
    <name>
      <text>Probability of Tossing an Even Number on a Fair Die</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p>In tossing a fair die it is assumed that each of the six faces has the same chance of turning up. What is the probability of the event that an even number is tossed?</p>
<p>[[input:ans1]] [[validation:ans1]][[feedback:prt1]]</p>]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text><![CDATA[<h3>Worked solution</h3>
<p>Sample space \(={@sample_space@}\) </p>
<p>Set of faces with even numbers \(={@sample_space_even@}\)</p>
<p> Probability of the event that an even number is tossed \( = \frac{\text{Cardinality of faces with even numbers}}{\text{Total number of faces on the die}}\)</p>
<p>\(\displaystyle  =\frac{{@cardinality_even@}}{{@cardinality_sample_space@}}\)</p>
<p>\( ={@ta@}\)</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
