a3:rand_with_prohib(10,20,[a1]);
a4:100-(a1+a2+a3);
a5:a1+a2+a3+a4;
p_a:float((a2+a3)/100);
p_b:float((a3+a4)/100);
p_anb:float(a3/100);
p_aub:p_a+p_b-p_anb;
ta:[[1,false, "Yes"], [2,true, "No"]];]]></text>
