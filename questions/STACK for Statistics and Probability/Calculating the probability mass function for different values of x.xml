    <questionvariables>
      <text>/*Question variables*/
num_def_list:makelist(rand(3),i,1,6); /*generate random numbers of defective for each lot*/

/*Calculating Model Answer*/
/*Dummy variables for counting*/
num_0:0;
num_1:0;
num_2:0;
i:0;
/*Actual counting*/
for i:1 thru 6 do (if num_def_list[i]=0 then num_0:num_0+1 elseif num_def_list[i]=1 then num_1:num_1+1 else num_2:num_2+1);
/*model answers*/
ta1:num_0/6;  /*prob of 0 defectives*/
ta2:num_1/6; /*prob of 1 defectives*/
ta3:num_2/6; /*prob of 2 defectives*/</text>
