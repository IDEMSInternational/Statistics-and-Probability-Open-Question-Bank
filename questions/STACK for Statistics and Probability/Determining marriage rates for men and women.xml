    <questionvariables>
      <text>/*topic 9 STA 246*/
no_marriages:(rand(800)+100)*1000;
total_popn:(rand_with_step(90000,100000,1000))*1000;
females:(rand_with_step(40000,50000,1000))*1000;
men:total_popn-females;
/*worked solution*/
sol1:(no_marriages/females)*1000; 
gmr_females:decimalplaces(sol1,2);
sol2:(no_marriages/men)*1000;
gmr_males:decimalplaces(sol2,2);</text>
    </questionvariables>
