    <questionvariables>
      <text>/*Randomly generate and calculate the initial probabilities*/
p_anb:float((rand(4)+1)/10);  /*P(AnB)*/
p_a:float((rand(2)+2)/10+p_anb); /*P(A)*/
p_b:float((rand(2)+1)/10+p_anb);  /*P(B)*/
p_aub:decimalplaces(p_a+p_b-p_anb,2);  /*P(AUB)*/
p_not:decimalplaces(1-p_aub,2); /*the complement of the set AUB*/

/*model answers*/
ta1:decimalplaces(p_aub,2);
ta2:decimalplaces(1-p_b,2); /* prob(B^c)*/
ta3:decimalplaces(p_a-p_anb,2);  /*prob(AnB^c)*/
ta4:decimalplaces(p_a+p_not,2); /*prob(AUB^c)*/</text>
    </questionvariables>
