    <questionvariables>
      <text>/*sta 246*/
aa:makelist((rand_with_step(35000,40000,500)), i, 1, 2);/*population of 0-14 1960 and 1975*/
ageset_1a:aa[1];
ageset_1b:aa[2];
bb:makelist((rand_with_step(30000,34500,500)), i, 1, 2);/*population of 15-29 1960 and 1975*/
ageset_2a:bb[1];
ageset_2b:bb[2];
cc:makelist((rand_with_step(25000,29500,500)), i, 1, 2);/*population of 30-34 1960 and 1975*/
ageset_3a:cc[1];
ageset_3b:cc[2];

births:rand_with_step(40000,50000,1000);

/*worked solution variables*/
p1:decimalplaces(ageset_2b/ageset_1a,3);

p2:decimalplaces(ageset_3b/(ageset_2a+ageset_3a),3);
pb:decimalplaces(ageset_1b/births,3);
sol1:20*((ageset_2a+(ageset_1a*p1))/2);
fert_rate:decimalplaces(births/sol1,3);
f2:decimalplaces(10*fert_rate*pb,4);
f1:decimalplaces(p1*10*fert_rate*pb,4);

/*projections*/
projection_1:round((f1*ageset_1b)+(f2*ageset_2b));
projection_2:round((ageset_1b*p1));
projection_3:round((p2*ageset_2b)+(p2*ageset_3b));</text>
    </questionvariables>
