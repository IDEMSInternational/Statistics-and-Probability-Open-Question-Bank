    <questionvariables>
      <text>/*STEM AND LEAF DIAGRAMS*/
s_1:rand(2)+1;
s_2:s_1+1;
s_3:s_1+2;
s_4:s_1+3;
s_5:s_1+4;
s_6:s_1+5;
s_7:s_1+6;
s_8:s_1+7;
/*leafs*/
l_1:rand(2)+1;
l_2:l_1+1;
l_3:l_1+2;
l_4:0;
l_5:l_1+3;
l_6:l_1+5;
/*worked solution variables*/
max_no: s_8*10+l_6; 
min_no: s_1*10+l_1;
ta1:max_no - min_no;
Q_2:1/2*(27+1);
ta2:sconcat(s_4,l_3+2);
Q_1:1/2*(13+1);
ta3:sconcat(s_3,l_3);
Q_3:1/2*(13+1);
ta4:sconcat(s_5,l_5);</text>
    </questionvariables>
