    <questionvariables>
      <text>/*Husband details*/
x1:rand(5)+1;
xx:float(x1/10);
ret_hubby:xx;
not_ret_hubby:1-ret_hubby;

/*Wife details*/
y1:rand_with_prohib(1,5,[x1]);
yy:float(y1/10);
ret_wife:yy;
not_ret_wife:1-ret_wife;

/*If wife retires*/
z1:rand_with_prohib(1,5,[x1,y1]);
zz:float(z1/10);
hubby_ret:zz;
hubby_not_ret:1-hubby_ret;


ss:(ret_hubby)*(ret_wife);
ta1:decimalplaces(ss,2);

a1:(ret_hubby)*(not_ret_wife);
a2:(not_ret_hubby)*(ret_wife);
rr:a1+a2;
ta2:decimalplaces(rr,2);

nn:(not_ret_wife)*(hubby_not_ret);
ta3:decimalplaces(nn,2);

b1:(ret_hubby)*(ret_wife);
b2:((ret_hubby)*(ret_wife))*((not_ret_hubby)*(not_ret_wife));
tt:(b1+b2)*2;
ta4:decimalplaces(tt,2);</text>
    </questionvariables>
