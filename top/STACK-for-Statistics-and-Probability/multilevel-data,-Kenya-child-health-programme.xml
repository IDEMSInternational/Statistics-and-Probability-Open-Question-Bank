      <text><![CDATA[/* ============================================================
   KENYA VACCINATION DATA
   Direct-construction version
   ============================================================ */


/* ------------------------------------------------------------
   1. Parameters
   ------------------------------------------------------------ */

counties:["Kakamega","Kisumu","Machakos","Turkana"];

A_households:[8,11,19,38,75];
B_households:[75,38,19,11,8];

A_prob:[55/100,65/100,75/100,85/100,90/100];
B_prob:[70/100,80/100,90/100,95/100,98/100];


/* ------------------------------------------------------------
   2. Cluster counties
   ------------------------------------------------------------ */

/*
   Clusters 1--4 belong to Programme A.
   Clusters 5--8 belong to Programme B.
*/

cluster_counties:
    makelist(
        counties[rand(4)+1],
        i,1,8
    );


/* ------------------------------------------------------------
   3. Initialise dataset
   ------------------------------------------------------------ */

/*
   Final child-level row structure:

   [cluster_id,
    county,
    programme,
    household_id,
    wealth_quintile,
    child_id,
    age_months,
    sex,
    fully_vaccinated]
*/

kenya_data:[];

household_id:0;
child_id:0;


/* ------------------------------------------------------------
   4. Initialise summary variables
   ------------------------------------------------------------ */

/*
   These scalar variables store the number of children and
   number vaccinated in each programme x wealth-quintile cell.

   We calculate them during data generation rather than
   searching kenya_data afterwards.
*/

A_n1:0;
A_n2:0;
A_n3:0;
A_n4:0;
A_n5:0;

A_vacc1:0;
A_vacc2:0;
A_vacc3:0;
A_vacc4:0;
A_vacc5:0;

B_n1:0;
B_n2:0;
B_n3:0;
B_n4:0;
B_n5:0;

B_vacc1:0;
B_vacc2:0;
B_vacc3:0;
B_vacc4:0;
B_vacc5:0;


/* ------------------------------------------------------------
   5. Programme A
   ------------------------------------------------------------ */

for q:1 thru 5 do block(
    [cell_households,
     n_cell,
     n_vaccinated,
     vaccination,
     hh_size,
     cluster_id,
     county,
     sex,
     age_months,
     k],

    /*
       Generate household sizes.

       Each household independently contains 4, 5 or 6 children.
    */

    cell_households:
        makelist(
            rand(3)+4,
            h,1,A_households[q]
        ),

    /*
       Number of children in this programme x wealth cell.
    */

    n_cell:
        sum(
            cell_households[h],
            h,1,A_households[q]
        ),

    /*
       Exact number vaccinated in the cell.
    */

    n_vaccinated:
        round(n_cell*A_prob[q]),

    /*
       Store the summary counts as scalar variables.
    */

    if q=1 then (
        A_n1:n_cell,
        A_vacc1:n_vaccinated
    ),

    if q=2 then (
        A_n2:n_cell,
        A_vacc2:n_vaccinated
    ),

    if q=3 then (
        A_n3:n_cell,
        A_vacc3:n_vaccinated
    ),

    if q=4 then (
        A_n4:n_cell,
        A_vacc4:n_vaccinated
    ),

    if q=5 then (
        A_n5:n_cell,
        A_vacc5:n_vaccinated
    ),

    /*
       Construct and randomly permute the vaccination vector.
    */

    vaccination:
        random_permutation(
            append(
                makelist(
                    1,
                    i,1,n_vaccinated
                ),
                makelist(
                    0,
                    i,1,n_cell-n_vaccinated
                )
            )
        ),

    k:1,

    /*
       Generate households and child-level records directly.
    */

    for h:1 thru A_households[q] do (

        household_id:household_id+1,

        hh_size:cell_households[h],

        cluster_id:rand(4)+1,

        county:cluster_counties[cluster_id],

        for c:1 thru hh_size do (

            child_id:child_id+1,

            age_months:rand(12)+12,

            sex:
                if rand(2)=0
                then "Female"
                else "Male",

            kenya_data:
                cons(
                    [
                        cluster_id,
                        county,
                        "A",
                        household_id,
                        q,
                        child_id,
                        age_months,
                        sex,
                        vaccination[k]
                    ],
                    kenya_data
                ),

            k:k+1
        )
    )
);


/* ------------------------------------------------------------
   6. Programme B
   ------------------------------------------------------------ */

for q:1 thru 5 do block(
    [cell_households,
     n_cell,
     n_vaccinated,
     vaccination,
     hh_size,
     cluster_id,
     county,
     sex,
     age_months,
     k],

    /*
       Generate household sizes.
    */

    cell_households:
        makelist(
            rand(3)+4,
            h,1,B_households[q]
        ),

    /*
       Number of children in this programme x wealth cell.
    */

    n_cell:
        sum(
            cell_households[h],
            h,1,B_households[q]
        ),

    /*
       Exact number vaccinated.
    */

    n_vaccinated:
        round(n_cell*B_prob[q]),

    /*
       Store summary counts as scalar variables.
    */

    if q=1 then (
        B_n1:n_cell,
        B_vacc1:n_vaccinated
    ),

    if q=2 then (
        B_n2:n_cell,
        B_vacc2:n_vaccinated
    ),

    if q=3 then (
        B_n3:n_cell,
        B_vacc3:n_vaccinated
    ),

    if q=4 then (
        B_n4:n_cell,
        B_vacc4:n_vaccinated
    ),

    if q=5 then (
        B_n5:n_cell,
        B_vacc5:n_vaccinated
    ),

    /*
       Construct and randomise vaccination outcomes.
    */

    vaccination:
        random_permutation(
            append(
                makelist(
                    1,
                    i,1,n_vaccinated
                ),
                makelist(
                    0,
                    i,1,n_cell-n_vaccinated
                )
            )
        ),

    k:1,

    /*
       Generate final child-level records.
    */

    for h:1 thru B_households[q] do (

        household_id:household_id+1,

        hh_size:cell_households[h],

        cluster_id:rand(4)+5,

        county:cluster_counties[cluster_id],

        for c:1 thru hh_size do (

            child_id:child_id+1,

            age_months:rand(12)+12,

            sex:
                if rand(2)=0
                then "Female"
                else "Male",

            kenya_data:
                cons(
                    [
                        cluster_id,
                        county,
                        "B",
                        household_id,
                        q,
                        child_id,
                        age_months,
                        sex,
                        vaccination[k]
                    ],
                    kenya_data
                ),

            k:k+1
        )
    )
);


/* ------------------------------------------------------------
   7. Randomise row order
   ------------------------------------------------------------ */

kenya_data:
    random_permutation(kenya_data);


/* ------------------------------------------------------------
   8. Column names and metadata
   ------------------------------------------------------------ */

kenya_columns:[
    "cluster_id",
    "county",
    "programme",
    "household_id",
    "wealth_quintile",
    "child_id",
    "age_months",
    "sex",
    "fully_vaccinated"
];

n_households:household_id;
n_children:child_id;


/* ------------------------------------------------------------
   9. Overall summary counts
   ------------------------------------------------------------ */

A_total_n:
    A_n1+A_n2+A_n3+A_n4+A_n5;

A_total_vacc:
    A_vacc1+A_vacc2+A_vacc3+A_vacc4+A_vacc5;

B_total_n:
    B_n1+B_n2+B_n3+B_n4+B_n5;

B_total_vacc:
    B_vacc1+B_vacc2+B_vacc3+B_vacc4+B_vacc5;


/* ------------------------------------------------------------
   10. Teacher answers
   ------------------------------------------------------------ */

/*
   Overall vaccination percentages.
*/

ta1:
    100*A_total_vacc/A_total_n;

ta2:
    100*B_total_vacc/B_total_n;


/*
   Overall apparent winner.

   Multiple-choice/radio teacher answer.
*/

ta3:[
    [1,true,"Programme A"],
    [2,false,"Programme B"]
];


/*
   Wealth quintile 1.
*/

ta4:
    100*A_vacc1/A_n1;

ta5:
    100*B_vacc1/B_n1;


/*
   Wealth quintile 2.
*/

ta6:
    100*A_vacc2/A_n2;

ta7:
    100*B_vacc2/B_n2;


/*
   Wealth quintile 3.
*/

ta8:
    100*A_vacc3/A_n3;

ta9:
    100*B_vacc3/B_n3;


/*
   Wealth quintile 4.
*/

ta10:
    100*A_vacc4/A_n4;

ta11:
    100*B_vacc4/B_n4;


/*
   Wealth quintile 5.
*/

ta12:
    100*A_vacc5/A_n5;

ta13:
    100*B_vacc5/B_n5;


/*
   Programme with the higher vaccination percentage
   within every wealth quintile.

   Multiple-choice/radio teacher answer.
*/

ta14:[
    [1,false,"Programme A"],
    [2,true,"Programme B"]
];]]></text>
