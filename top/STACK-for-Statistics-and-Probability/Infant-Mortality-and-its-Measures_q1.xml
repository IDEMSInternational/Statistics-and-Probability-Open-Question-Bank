      <text>/*topic 8*/
deaths:makelist((rand_with_step(5000,5500,100)),i,1,2);
d1:deaths[1];
d3:deaths[2]+rand(500);
/*d2 and d4*/
deaths_2:makelist((rand_with_step(10000,12000,1000)),i,1,2);
d2:deaths_2[1];
d4:deaths_2[2]+rand(500);
/*live births*/
births:makelist((rand_with_step(180000,200000,1000)),i,1,2);
b1:births[1];
b2:births[2]+rand(1000);
/*worked solution variables*/
sol1:decimalplaces(((d1+d2)/b1)*1000,2);
sol2:decimalplaces((1-(b2-d4)/b2)*((b1-d2-d3)/(b1-d2))*1000,2);
/*model answers*/
ta1:sol1;
ta2:sol2;</text>
