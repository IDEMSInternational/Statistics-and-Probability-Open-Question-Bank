p_5_rate:decimalplaces(ageset_5b/ageset_4a,3);

p_1:ceiling((1+p_1_rate)*ageset_1a);
p_2:ceiling((1+p_2_rate)*ageset_2a);
p_3:ceiling((1+p_3_rate)*ageset_3a);
p_4:ceiling((1+p_4_rate)*ageset_4a);
p_5:ceiling((1+p_5_rate)*ageset_5a);</text>
