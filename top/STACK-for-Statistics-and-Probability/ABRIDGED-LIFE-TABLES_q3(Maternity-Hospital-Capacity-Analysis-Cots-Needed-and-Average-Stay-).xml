    <questionvariables>
      <text>/* Defined the percentages */  
ap1: rand(3)+2;  
ap2: rand_with_prohib(1,8,[ap1]);
ap3: rand_with_prohib(1,8,[ap1,ap2]); 
ap4: rand_with_prohib(1,8,[ap1,ap2,ap3]);  
ap5: rand_with_prohib(1,8,[ap1,ap2,ap3,ap4]);
pp:[ap1,ap2,ap3,ap4,ap5]*10;
p1:pp[1];
p2:pp[2];
p3:pp[3];
p4:pp[4];
p5:pp[5];

/* Number of newborn babies delivered per week */ 
newborn_per_week: rand_with_step(10,50,10); 
weeks:makelist(i,i,0,6);

/* Initial number of newborns */ 
l0: newborn_per_week*newborn_per_week; /*the 100*/
/* Calculate lx for each week */ 
l1: l0 - p1/100 * l0; 
l2: l1 - p2/100 * l1; 
l3: l2 - p3/100 * l2; 
l4: l3 - p4/100 * l3; 
l5: l4 - p5/100 * l4; 
l6: l5 - 100/100 * l5;  /* All babies have left the hospital by week 6 */  
lx: round([l0, l1, l2, l3, l4, l5, l6]);

/* Define lists for lx and lx+n for each week */
lx_values:round([l0, l1, l2, l3, l4, l5]) ;
lx_n_values: round([l1, l2, l3, l4, l5, l6] );  

/* Calculate ndx and nqx for each week */ 
ndx_values: makelist(lx_values[i] - lx_n_values[i], i, 1, length(lx_values));
nqx_values: decimalplaces(ndx_values / lx_values,2); 

/* Calculate midpoint between corresponding elements */ 
midpoint_values_Lx:round (makelist((lx_values[i] + lx_n_values[i]) / 2, i, 1, length(lx_values)));

/*cumulative frequencies*/
midpoint_values_Lxr:reverse(midpoint_values_Lx);
Tx: makelist(sum(midpoint_values_Lxr[i], i, 1, j), j, 1, length(midpoint_values_Lxr)); 

/*sum(midpoint_values_Lx);*/ 
total_Lx:sum(midpoint_values_Lxr[i],i,1,length(midpoint_values_Lxr)); 
Tx_values:reverse(Tx);

e0x_values: decimalplaces(makelist(Tx_values[i]/lx_values[i], i, 1, length(lx_values)),2);

max_cots_at_hospital:round((newborn_per_week/l0)*total_Lx); /*number of beds or spaces needed to accommodate newborn babies and infants  */
average_stay:decimalplaces(total_Lx/l0,2); /*average stay in the hospital*/
check_point:is(average_stay=e0x_values[1]);

/*Model answers*/
ta1:ndx_values[2];
ta2:ndx_values[4];
ta3:nqx_values[1];
ta4:round(nqx_values[6]);
ta5:midpoint_values_Lx[3];
ta6:midpoint_values_Lx[5];
ta7:Tx_values[1];
ta8:Tx_values[4];
ta9:e0x_values[2];
ta10:e0x_values[6];
ta11:max_cots_at_hospital;
ta12:average_stay;</text>
