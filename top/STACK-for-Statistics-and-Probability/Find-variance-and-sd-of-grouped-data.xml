    <questionvariables>
      <text>/*class intervals*/
aa: rand(2)+2;
bb: rand_with_step(4,6,1);/*class limit*/
class_size:bb+1;/*class size*/
/*class intervals*/
x1:aa;/*1st lower class limit*/
x1_1:x1+bb;/*1st upper class limit*/
x2:x1_1+1;/*2nd class lower limit*/
x2_1:x2+bb;/*2nd class upper limit*/
x3:x2_1+1;/*3rd class lower limit*/
x3_1:x3+bb;/*3rd class upper limit*/
x4:x3_1+1;/*4th class lower limit*/
x4_1:x4+bb;/*4th class upper limit*/


/*frequencies*/
f1:rand(2)+2;/* 1st frequency*/
f2:rand_with_prohib(1,4,[f1]);/* 2nd frequency*/
f3:rand_with_prohib(2,6,[f1,f2]);/* 3rd frequency*/
f4:rand_with_prohib(2,6,[f1,f2,f3]);/* 4th frequency*/
total_frequencies:f1+f2+f3+f4; /*total n*/



/*Worked out solution break down_ midpoint and product of midpoint and freq*/
m_1:float((x1+x1_1)/2); fx1:m_1*f1;
m_2:float((x2+x2_1)/2); fx2:m_2*f2; 
m_3:float((x3+x3_1)/2); fx3:m_3*f3; 
m_4:float((x4+x4_1)/2); fx4:m_4*f4;


sum_fi_xi:fx1+fx2+fx3+fx4;
/*worked solution variables*/
sum_f_midpoints:fx1+fx2+fx3+fx4;/*midpoints times the frequencies*/
mean:decimalplaces(sum_f_midpoints/total_frequencies,2);
sum_f_midpoints:fx1+fx2+fx3+fx4;/*midpoints times the frequencies*/
/*Column 4- difference between mean and midpoint*/
x1_mean:decimalplaces(m_1-mean,2);/*midpoint 1 minus mean*/
x2_mean:decimalplaces(m_2-mean,2);/*midpoint 2 minus mean*/
x3_mean:decimalplaces(m_3-mean,2);/*midpoint 3 minus mean*/
x4_mean:decimalplaces(m_4-mean,2);/*midpoint 4 minus mean*/

/*square values of difference between mean and midpoint*/
square_x1_mean:decimalplaces((x1_mean)^2,2);/*square of midpoint 1 minus mean*/
square_x2_mean:decimalplaces((x2_mean)^2,2);/*square of midpoint 2 minus mean*/
square_x3_mean:decimalplaces((x3_mean)^2,2);/*square of midpoint 3 minus mean*/
square_x4_mean:decimalplaces((x4_mean)^2,2);/*square of midpoint 4 minus mean*/
sum_squares:square_x1_mean+square_x2_mean+square_x3_mean+square_x4_mean;/*sum of the squares*/
/*frequencis times the diff between midpoint and mean*/
f1_square_mean_m:decimalplaces(f1*square_x1_mean,2);
f2_square_mean_m:decimalplaces(f2*square_x2_mean,2);
f3_square_mean_m:decimalplaces(f3*square_x3_mean,2);
f4_square_mean_m:decimalplaces(f4*square_x4_mean,2);
sum_f_square_mean_m:decimalplaces(f1_square_mean_m+f2_square_mean_m+f3_square_mean_m+f4_square_mean_m,2);
/*variance*/
variance:decimalplaces(sum_f_square_mean_m/total_frequencies,2);
/*standard deviation*/
std_deviation:decimalplaces(sqrt(variance),2);
/*model answers*/
ta1:mean;
ta2:variance;
ta3:std_deviation;</text>
