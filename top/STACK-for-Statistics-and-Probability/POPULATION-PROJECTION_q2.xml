      <text>/*sta 246*/
aa:makelist((rand_with_step(60000,65000,500)), i, 1, 2);/*population of 0-14 1960 and 1975*/
ageset_1a:aa[1];
ageset_1b:aa[2];
bb:makelist((rand_with_step(50000,60000,500)), i, 1, 2);/*population of 15-29 1960 and 1975*/
ageset_2a:bb[1];
ageset_2b:bb[2];
cc:makelist((rand_with_step(45000,49000,500)), i, 1, 2);/*population of 30-34 1960 and 1975*/
ageset_3a:cc[1];
ageset_3b:cc[2];
dd:makelist((rand_with_step(40000,44000,500)), i, 1, 2);/*population of 45-59 1960 and 1975*/
ageset_4a:dd[1];
ageset_4b:dd[2];
ee:makelist((rand_with_step(35000,40000,500)), i, 1, 2);/*population of 60+ 1960 and 1975*/
ageset_5a:ee[1];
ageset_5b:ee[2];

/*worked solution variables*/
p_1_rate:decimalplaces(ageset_2b/ageset_1a,3);
p_2_rate:decimalplaces(ageset_3b/ageset_2a,3);
p_3_rate:decimalplaces(ageset_4b/ageset_3a,3);
p_4_rate:decimalplaces(ageset_5b/ageset_4a,3);
p_5_rate:decimalplaces(ageset_5b/ageset_4a,3);

births_1:rand_with_step(30000,40000,100);
births_2:rand_with_step(20000,29000,100);
sol1:(ageset_2a+(ageset_1a*p_1_rate))*(15/2);
f_2:decimalplaces(births_1/sol1,3);/*fertility rate 2*/
sol2:(ageset_3a+(ageset_2a*p_2_rate))*(15/2);
f_3:decimalplaces(births_2/sol2,3);
/*projection fertility rates*/
p_b:decimalplaces(ageset_1b/(births_1+births_2),3);/*probability of a baby born surviving to time t+15*/
f1:decimalplaces(p_1_rate*(15/2)*f_2*p_b,3);
f2:decimalplaces((p_2_rate*(15/2)*f_3*p_b)+((15/2)*f_2*p_b),3);
f3:decimalplaces((15/2)*f_3*p_b,3);</text>
