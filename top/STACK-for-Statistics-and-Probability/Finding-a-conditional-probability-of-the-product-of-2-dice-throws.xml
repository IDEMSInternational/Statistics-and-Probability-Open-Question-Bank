    <questionvariables>
      <text><![CDATA[/*Question 1*/
/*random generation of outcomes*/
one_die:rand(4)+2;
exact_product:one_die*(rand(4)+2);
more_than_product:rand_with_step(2*one_die+1,4*one_die-1,1);

/*Model answer*/
ta_1:2/11;
sample_21:makelist(i*one_die,i,1,6);
sample_22:delete(one_die^2,sample_21);
count_more_than:0;
for i:1 thru 6 do (if sample_21[i] >more_than_product then count_more_than:count_more_than+1);
for i:1 thru 5 do (if sample_22[i] >more_than_product then count_more_than:count_more_than+1);
ta_2:count_more_than/11;]]></text>
    </questionvariables>
