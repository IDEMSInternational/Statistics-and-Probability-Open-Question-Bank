    <questionvariables>
      <text>/*LIFE TABLES*/
/*part a*/
years:rand([5,10,15,20,25]);
l_0:100000;/*original population*/
l_x:if years=5 then 77007 else if years=10 then 74889 else if years=15 then 73260 else if years=20 then 71116 else if years=25 then 68469; /*population on the table*/
population:rand(50000)+300000;/*popluation over the years*/
/*solutions*/
sol1:floor(float((l_x/l_0)*population));


/*part b*/
/*event b*/
event_a_b:rand([10,15,20,25,30]);
age:25;
l_f:age+event_a_b;/*age in the next 10yrs*/
l_f_x:if event_a_b=10 then 62472 else if event_a_b=15 then 59159 else if event_a_b=20 then 55674 else if event_a_b=25 then 51922 else if event_a_b=30 then 47279;/*l_x in next yrs*/
l_f_age:68469; /*l_x in exact age*/
/*solution*/
soln1:1-(l_f_x/l_f_age);
probability_b:float(soln1);
/*male events*/
age:25;
l_m:age+event_a_b;/*age in the next 10yrs*/
l_m_x:if event_a_b=10 then 60279 else if event_a_b=15 then 56705 else if event_a_b=20 then 52558 else if event_a_b=25 then 47858 else if event_a_b=30 then 42223;/*l_x in next 10yrs*/
l_m_age:66352; /*l_x in exact age*/
/*solution*/
soln2:1-(l_m_x/l_m_age);
probability_a:float(soln2);
/* both parents probability*/
p_aub:probability_a+probability_b-(probability_a*probability_b);

/*sons probabilities*/
sons_age:event_a_b;
l_x_sons:if sons_age=10 then 72523 else if sons_age=15 then 71094 else if sons_age=20 then 69096 else if sons_age=25 then 66352 else if sons_age=30 then 63457;
/*solution*/
s1:decimalplaces(1-(l_x_sons/100000),3);
p_c1_c2:2*(s1)-(s1^2);
s2:decimalplaces(p_c1_c2,3);

/*model answers*/
ta1:sol1;
ta2:decimalplaces(probability_b,3);
ta3:decimalplaces(probability_a,3);
ta4:decimalplaces(p_aub,3);
ta5:s2;</text>
