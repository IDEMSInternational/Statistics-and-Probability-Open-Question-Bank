    <questionvariables>
      <text>/* Generate a random dataset containing 20 positive integers */
data:makelist(1+rand(1+rand(500)),i,1,20);

/* Calculate the arithmetic mean of the dataset */
mean_data:mean(data);

/* Convert the mean to a floating-point value for the student answer */
ta1:float(mean_data);

/* Calculate the median of the dataset */
median_data:median(data);

/* Convert the median to a floating-point value for the student answer */
ta2:float(median_data);

/* Calculate the population standard deviation of the dataset */
std_data:std(data);

/* Convert the standard deviation to a floating-point value for the student answer */
ta3:float(std_data);

/* Calculate the first quartile */
q1:quantile(data,1/4);

/* Calculate the third quartile */
q3:quantile(data,3/4);

/* Calculate the interquartile range (Q3 - Q1) */
iqr_data:q3-q1;

/* Convert the interquartile range to a floating-point value for the student answer */
ta4:float(iqr_data);

/* Variables for display in general feedback */
/* Format the mean without unnecessary trailing zeros */
disp_mean:
    if integerp(mean_data) then mean_data
    elseif integerp(10*mean_data) then dispdp(float(mean_data),1)
    else dispdp(float(mean_data),2);

/* Format the median without unnecessary trailing zeros */
disp_median:
    if integerp(median_data) then median_data
    elseif integerp(10*median_data) then dispdp(float(median_data),1)
    else dispdp(float(median_data),2);

/* Format the standard deviation without unnecessary trailing zeros */
disp_std:
    if integerp(std_data) then std_data
    elseif integerp(10*std_data) then dispdp(float(std_data),1)
    else dispdp(float(std_data),2);

/* Format the first quartile without unnecessary trailing zeros */
disp_q1:
    if integerp(q1) then q1
    elseif integerp(10*q1) then dispdp(float(q1),1)
    else dispdp(float(q1),2);

/* Format the third quartile without unnecessary trailing zeros */
disp_q3:
    if integerp(q3) then q3
    elseif integerp(10*q3) then dispdp(float(q3),1)
    else dispdp(float(q3),2);

/* Format the interquartile range without unnecessary trailing zeros */
disp_iqr:
    if integerp(iqr_data) then iqr_data
    elseif integerp(10*iqr_data) then dispdp(float(iqr_data),1)
    else dispdp(float(iqr_data),2);</text>
    </questionvariables>
