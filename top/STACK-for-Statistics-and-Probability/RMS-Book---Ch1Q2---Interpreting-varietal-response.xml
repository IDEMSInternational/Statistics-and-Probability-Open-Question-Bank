    <questionvariables>
      <text><![CDATA[/* Three deliberately distinct response patterns, in tenths of t/ha. */
pattern:rand(3);
base:rand(9)+28;
aL:base;
bL:base+8;
aM:base+17;
aH:base+34;
bM:if pattern=0 then base+17 else if pattern=1 then base+13 else base+22;
bH:if pattern=0 then base+42 else if pattern=1 then base+26 else base+50;
ta1:(bL-aL)/10;
ta2:(bH-aH)/10;
ta3:ta2-ta1;
ta4:if pattern=0 then 1 else if pattern=1 then 2 else 3;
options4:random_permutation([
[1,is(pattern=0),"The variety contrast is unchanged between low and high irrigation"],
[2,is(pattern=1),"Variety B's advantage becomes smaller at high irrigation"],
[3,is(pattern=2),"Variety B's advantage becomes larger at high irrigation"]
]);]]></text>
