    <questionvariables>
      <text>/*Question variables*/
list1: [x_1,x_2,x_3,x_n];
given_stddev:rand(10)+3;
transformation_factor:rand_with_prohib(-5,10,[0,given_stddev]);  
shift_factor: given_stddev; /*3*/
a:transformation_factor*x_1+shift_factor;
b:transformation_factor*x_2+shift_factor;
c:transformation_factor*x_n+shift_factor;
new_stddev: given_stddev * abs(transformation_factor);</text>
    </questionvariables>
