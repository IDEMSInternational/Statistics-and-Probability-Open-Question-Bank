    <questionvariables>
      <text>class_tot:rand_with_step(15,25,1);
group_1:round(class_tot/2)+rand_with_step(1,3,1);
group_2:class_tot-group_1;
ta:(binomial(class_tot-2, group_1)+binomial(class_tot-2, group_2));</text>
